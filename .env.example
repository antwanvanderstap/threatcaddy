# ThreatCaddy deployment configuration.
#
# Copy to `.env` beside the compose file and fill in. Used by both
# docker-compose.yml (API only) and docker-compose.selfhost.yml (full stack).
#
#   cp .env.example .env
#
# Never commit the result — `.env` is gitignored.

# ── Hostnames (full stack only) ──────────────────────────────────────
# Both must resolve to this machine. Split across two names so the admin
# panel can be firewalled independently of the app.
TC_DOMAIN=threatcaddy.example.com
TC_ADMIN_DOMAIN=admin.threatcaddy.example.com

# Must match TC_DOMAIN exactly, scheme included. The server rejects browser
# requests from any other origin.
ALLOWED_ORIGINS=https://threatcaddy.example.com

# ── TLS (full stack only) ────────────────────────────────────────────
# Where the CA sends renewal-failure warnings. Optional but worth setting.
TC_TLS_EMAIL=

# How Caddy obtains certificates. One of:
#
#   dns-ionos   ACME DNS-01 through the IONOS API. Validation happens over a
#               TXT record, so this needs NO inbound connectivity — the only
#               way to get a publicly trusted certificate when the ISP blocks
#               inbound ports. Requires TC_IONOS_API_TOKEN below.
#   internal    Caddy's own CA. No external dependency, but every client must
#               trust the root certificate once (awkward on phones).
#   acme-http   Classic HTTP-01. Requires ports 80 and 443 reachable.
#
# The app needs TLS in some form regardless: crypto.subtle is unavailable
# outside a secure context, so over plain HTTP the at-rest encryption and
# encrypted backups stop working.
TC_TLS_MODE=internal

# IONOS DNS API token, used only by TC_TLS_MODE=dns-ionos. Format is the
# public prefix and secret joined by a dot. Create it in the IONOS DNS
# dashboard; it needs permission to write TXT records on the zone.
# This is a credential — treat it like the JWT key.
TC_IONOS_API_TOKEN=

# Which ACME directory to use. Leave unset for Let's Encrypt production.
#
# On a FIRST deployment, use staging instead:
#   TC_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
#
# Production allows only a handful of failed validations per hostname per
# hour. If DNS or the token is wrong you will exhaust that before you have
# diagnosed it, then wait it out. Staging certificates are untrusted by
# browsers — expect a warning — but they prove the whole path works. Switch
# to production and restart once a staging cert is issued.
TC_ACME_CA=

# Who may reach the admin panel. `private_ranges` covers RFC1918. Can be a
# space-separated list of CIDRs, e.g. `10.10.0.0/24 192.168.1.0/24`.
TC_ADMIN_ALLOW_IPS=private_ranges

# ── Database ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── JWT signing keys (required) ──────────────────────────────────────
# Generate an Ed25519 pair:
#
#   openssl genpkey -algorithm Ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#
# Then append both, quoted and multi-line, straight from the files:
#
#   { printf 'JWT_PRIVATE_KEY="'; cat private.pem; printf '"\n'
#     printf 'JWT_PUBLIC_KEY="';  cat public.pem;  printf '"\n'; } >> .env
#
# The newlines must survive. Compose preserves them inside quotes, and the
# server hands the value straight to jose.importPKCS8, which expects a real
# PEM. Flattening to one line with literal \n escapes fails with
# "asn1 encoding routines::too long" — but only on the first login, long
# after the server has started cleanly.
#
# Rotating these invalidates every existing session.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Admin bootstrap (optional) ───────────────────────────────────────
# Creates the first admin user. If left blank, a random secret is written to
# /data/files/.admin-secret on first launch — read it, then delete it.
ADMIN_SECRET=

# Encrypts stored bot credentials. Required only if you use the bot system.
# Generate: openssl rand -base64 32
BOT_MASTER_KEY=

# ── LLM API keys (optional) ──────────────────────────────────────────
# Only needed for server-side agents. The client can supply its own keys
# through the extension instead, in which case leave these empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
